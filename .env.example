# Ethereum Guard — Environment Configuration Template
# Copy this file to `.env` and fill in your credentials. NEVER commit `.env` to Git.

# Etherscan API V2 Key (Required for live on-chain transaction & wallet scanning)
# Obtain free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional Alchemy / Infura Ethereum Mainnet RPC URL
ALCHEMY_RPC_URL=your_alchemy_rpc_url_optional

# Optional API Key guard for POST /predict/batch (leave blank for local open demo)
ETHEREUM_GUARD_API_KEY=

# Optional FastAPI Base URL for Streamlit HTTP client mode (leave blank for direct in-memory Engine)
ETHEREUM_GUARD_API_URL=

# FastAPI CORS Allowed Origins (comma-separated URLs, or '*' for local development without credentials)
ETHEREUM_GUARD_CORS_ORIGINS=*
